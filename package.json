{
  "name": "campus-control",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Central de Gestión Operativa de Campuslands: espacios, equipos e incidencias con triaje por IA (Nemotron).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch server/index.js --dev\" \"vite\"",
    "dev:api": "node --watch server/index.js --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
