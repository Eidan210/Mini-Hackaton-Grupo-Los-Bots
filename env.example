# Plantilla de variables de entorno. Cópiala como ".env" en la raíz y rellena los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# IA: Nemotron Ultra vía API de NVIDIA (compatible con OpenAI). Clave gratuita en build.nvidia.com
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# PostgreSQL (Supabase): Project Settings > Database > Connection string (URI, "Session pooler").
# Si se deja vacío, se usa PostgreSQL embebido (PGlite) en ./.pgdata
DATABASE_URL=

# Texto largo y aleatorio para firmar las sesiones
SESSION_SECRET=

# Puerto en producción (en desarrollo la API usa 3001 y la web 5173)
PORT=3001
