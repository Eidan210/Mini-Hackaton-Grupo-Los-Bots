# Plantilla de variables de entorno. Cópiala como ".env" en la raíz y rellena los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

# IA: Nemotron vía OpenRouter (gratis). Clave en openrouter.ai/keys
NEMOTRON_API_KEY=
# Opcionales (estos son los valores por defecto):
# NEMOTRON_BASE_URL=https://openrouter.ai/api/v1
# NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# NEMOTRON_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free

# PostgreSQL (Supabase): Connect > Session pooler > URI (con tu contraseña).
# Si se deja vacío, se usa PostgreSQL embebido (PGlite) en ./.pgdata
DATABASE_URL=

# Texto largo y aleatorio para firmar las sesiones
SESSION_SECRET=

# Contraseña de los usuarios de prueba (@campus.demo). Se guarda con hash al iniciar el servidor.
SEED_PASSWORD=

# true = muestra en el login el acceso rápido por perfil (solo para la presentación)
DEMO_LOGIN=false

# Puerto en producción (en desarrollo la API usa 3001 y la web 5173)
PORT=3001
